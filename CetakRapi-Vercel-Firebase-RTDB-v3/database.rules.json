{
  "rules": {
    ".read": false,
    ".write": false,
    "orderFiles": {
      "$uploadId": {
        ".read": false,
        ".write": "auth != null && auth.uid === $uploadId && auth.token.upload === true && !data.exists()",
        ".validate": "newData.hasChildren(['data', 'mime', 'name', 'size'])",
        "data": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10000000"
        },
        "mime": {
          ".validate": "newData.isString() && newData.val() === auth.token.uploadMime && (newData.val() === 'image/png' || newData.val() === 'image/jpeg' || newData.val() === 'application/pdf' || newData.val() === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' || newData.val() === 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')"
        },
        "name": {
          ".validate": "newData.isString() && newData.val() === auth.token.uploadName && newData.val().length > 0 && newData.val().length <= 120"
        },
        "size": {
          ".validate": "newData.isNumber() && newData.val() === auth.token.uploadSize && newData.val() > 0 && newData.val() <= 7340032"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "orders": {
      ".indexOn": ["created_at"]
    }
  }
}
